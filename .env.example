# PostgreSQL is the source of truth for website accounts and subscriptions.
DATABASE_URL=postgresql+psycopg://newsdigest:change-me@127.0.0.1:5432/newsdigest

# Generate distinct, high-entropy values before deployment. Never commit .env.
APP_SESSION_SECRET=replace-with-a-random-secret
INVITE_LOOKUP_KEY=replace-with-a-random-secret
WEBHOOK_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
