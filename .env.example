# PostgreSQL is the source of truth for website accounts and subscriptions.
DATABASE_URL=postgresql+psycopg://newsdigest:change-me@127.0.0.1:5432/newsdigest
APP_ENV=production
FRONTEND_DEV_MODE=false
# Local-only Vite HMR origin. Leave blank in production.
VITE_DEV_SERVER_URL=

# Generate distinct, high-entropy values before deployment. Never commit .env.
APP_SESSION_SECRET=replace-with-a-random-secret
INVITE_LOOKUP_KEY=replace-with-a-random-secret
WEBHOOK_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
ADMIN_USERNAMES=your-admin-username

# PostgreSQL custom-format backups. Directory owner must be newsdigest and mode 0700.
POSTGRES_BACKUP_DIR=/var/lib/newsday/backups/postgresql

# Optional: receives non-sensitive failure notices from maintenance tasks.
ALERT_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/replace-me
