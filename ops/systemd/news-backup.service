[Unit]
Description=Newsday PostgreSQL backup with fourteen-day retention
After=network.target postgresql.service

[Service]
Type=oneshot
User=newsdigest
Group=newsdigest
UMask=0077
WorkingDirectory=/opt/newsday/current
EnvironmentFile=/etc/newsday/newsday.env
ExecStart=/opt/newsday/current/.venv/bin/python -m app.postgres_backup_cli --apply
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/newsday/backups/postgresql
