[Unit]
Description=Newsday seven-day retention cleanup
After=postgresql.service

[Service]
Type=oneshot
User=newsdigest
Group=newsdigest
UMask=0077
WorkingDirectory=/opt/newsday
EnvironmentFile=/etc/newsday/newsday.env
ExecStart=/opt/newsday/.venv/bin/python -m app.retention_cli --apply
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/newsday/data /opt/newsday/output
