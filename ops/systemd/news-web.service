[Unit]
Description=Newsday web application
After=network.target postgresql.service

[Service]
Type=simple
User=newsdigest
Group=newsdigest
WorkingDirectory=/opt/newsday
EnvironmentFile=/etc/newsday/newsday.env
ExecStart=/opt/newsday/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
