[Unit]
Description=Newsday web application
After=network.target postgresql.service

[Service]
Type=simple
User=newsdigest
Group=newsdigest
UMask=0077
WorkingDirectory=/opt/newsday/current
EnvironmentFile=/etc/newsday/newsday.env
ExecStart=/opt/newsday/current/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 18000 --workers 2
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
