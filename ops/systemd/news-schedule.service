[Unit]
Description=Newsday create due delivery jobs
After=network.target postgresql.service

[Service]
Type=oneshot
User=newsdigest
Group=newsdigest
UMask=0077
WorkingDirectory=/opt/newsday/current
EnvironmentFile=/etc/newsday/newsday.env
ExecStart=/opt/newsday/current/.venv/bin/python -m app.worker_cli schedule
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
