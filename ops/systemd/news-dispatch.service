[Unit]
Description=Newsday dispatch due delivery jobs
After=network.target postgresql.service

[Service]
Type=oneshot
User=newsdigest
Group=newsdigest
UMask=0077
WorkingDirectory=/opt/newsday
EnvironmentFile=/etc/newsday/newsday.env
ExecStart=/opt/newsday/.venv/bin/python -m app.worker_cli dispatch
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
