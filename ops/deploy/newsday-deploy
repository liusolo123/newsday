#!/usr/bin/env bash
# Root-owned release activator. It accepts only a Git commit SHA and reads the
# corresponding artifact from the deploy user's write-only incoming directory.
set -euo pipefail

readonly app_root=/opt/newsday
readonly releases_dir="$app_root/releases"
readonly runtime_dir=/var/lib/newsday/runtime
readonly incoming_dir=/var/lib/newsday/incoming
readonly cache_dir=/var/lib/newsday/cache
readonly service_user=newsdigest
readonly uv_bin=/usr/local/bin/uv
readonly python_dir=/opt/newsday/python
readonly sha="${1:-}"

if [[ ! "$sha" =~ ^[0-9a-f]{40}$ ]]; then
  echo "Expected one full, lowercase Git commit SHA." >&2
  exit 2
fi

readonly artifact="$incoming_dir/newsday-$sha.tar.gz"
readonly release_dir="$releases_dir/$sha"
readonly candidate_dir="$releases_dir/.${sha}.candidate"

run_as_service() {
  sudo -u "$service_user" env HOME=/var/lib/newsday XDG_CACHE_HOME="$cache_dir" UV_PYTHON_INSTALL_DIR="$python_dir" bash -c '
    set -a
    . /etc/newsday/newsday.env
    set +a
    exec "$@"
  ' -- "$@"
}

if [[ ! -f "$artifact" ]]; then
  echo "Release artifact is missing: $artifact" >&2
  exit 3
fi
if [[ ! -x "$uv_bin" ]] || ! UV_PYTHON_INSTALL_DIR="$python_dir" "$uv_bin" python find 3.12 >/dev/null 2>&1; then
  echo "Deployment requires /usr/local/bin/uv and its managed Python 3.12; run the documented server prerequisites first." >&2
  exit 5
fi
if [[ -e "$release_dir" ]]; then
  echo "Release $sha is already installed; refusing to overwrite it." >&2
  exit 4
fi

activation_complete=false
cleanup_incomplete_release() {
  if [[ "$activation_complete" != true ]]; then
    rm -rf "$candidate_dir" "$release_dir"
  fi
}
trap cleanup_incomplete_release EXIT

install -d -o "$service_user" -g "$service_user" -m 0750 "$releases_dir" "$runtime_dir/data" "$runtime_dir/output" "$cache_dir"
install -d -o newsday-deploy -g newsday-deploy -m 0730 "$incoming_dir"
mkdir -m 0750 "$candidate_dir"
tar --extract --gzip --file="$artifact" --directory="$candidate_dir" --no-same-owner --no-same-permissions
chown -R "$service_user:$service_user" "$candidate_dir"
ln -s "$runtime_dir/data" "$candidate_dir/data"
ln -s "$runtime_dir/output" "$candidate_dir/output"
mv "$candidate_dir" "$release_dir"
cd "$release_dir"

run_as_service "$uv_bin" venv "$release_dir/.venv" --python 3.12
run_as_service "$uv_bin" pip sync --python "$release_dir/.venv/bin/python" "$release_dir/requirements.lock"

for unit in "$release_dir"/ops/systemd/news-*; do
  install -o root -g root -m 0644 "$unit" "/etc/systemd/system/$(basename "$unit")"
done
systemctl daemon-reload

systemctl stop news-web.service news-ingest.timer news-schedule.timer news-dispatch.timer news-retention.timer news-backup.timer
previous_target=""
if [[ -L "$app_root/current" ]]; then
  previous_target="$(readlink "$app_root/current")"
fi
restore_services() {
  if [[ -n "$previous_target" && ! -L "$app_root/current" ]]; then
    ln -s "$previous_target" "$app_root/current"
  fi
  systemctl start news-web.service news-ingest.timer news-schedule.timer news-dispatch.timer news-retention.timer news-backup.timer || true
}
trap restore_services ERR

run_as_service "$release_dir/.venv/bin/python" -m app.postgres_backup_cli --apply
run_as_service "$release_dir/.venv/bin/python" -m alembic upgrade head

ln -s "releases/$sha" "$app_root/current.next"
mv -Tf "$app_root/current.next" "$app_root/current"
systemctl start news-web.service news-ingest.timer news-schedule.timer news-dispatch.timer news-retention.timer news-backup.timer
rm -f "$artifact"
activation_complete=true
trap - ERR
trap - EXIT
echo "Activated Newsday release $sha"
